  "components": {
    "schemas": {
      "Evidence": {
        "properties": {
          "label": {
            "type": "string",
            "title": "Label"
          },
          "value": {
            "type": "string",
            "title": "Value"
          },
          "note": {
            "type": "string",
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "label",
          "value",
          "note"
        ],
        "title": "Evidence"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Signal": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "severity": {
            "type": "string",
            "enum": [
              "high",
              "watch",
              "research_flag"
            ],
            "title": "Severity"
          },
          "as_of": {
            "type": "string",
            "title": "As Of"
          },
          "district": {
            "type": "string",
            "title": "District"
          },
          "borough": {
            "type": "string",
            "title": "Borough"
          },
          "problem": {
            "type": "string",
            "title": "Problem"
          },
          "agency": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agency"
          },
          "observed": {
            "type": "number",
            "title": "Observed"
          },
          "expected": {
            "type": "number",
            "title": "Expected"
          },
          "effect": {
            "type": "number",
            "title": "Effect"
          },
          "uncertainty": {
            "type": "string",
            "title": "Uncertainty"
          },
          "persistence": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Persistence"
          },
          "trigger": {
            "type": "string",
            "title": "Trigger"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "data_quality_flags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Data Quality Flags"
          },
          "limitation": {
            "type": "string",
            "title": "Limitation"
          },
          "recommended_action": {
            "type": "string",
            "title": "Recommended Action"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "display_effect": {
            "type": "string",
            "title": "Display Effect"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          },
          "episode_start": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Episode Start"
          },
          "episode_end": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Episode End"
          },
          "upper_bound": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Upper Bound"
          },
          "excess_count": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Excess Count"
          },
          "calibrated_score": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Calibrated Score"
          },
          "detector": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detector"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "id",
          "type",
          "severity",
          "as_of",
          "district",
          "borough",
          "problem",
          "observed",
          "expected",
          "effect",
          "uncertainty",
          "persistence",
          "trigger",
          "evidence",
          "data_quality_flags",
          "limitation",
          "recommended_action",
          "title",
          "display_effect"
        ],
        "title": "Signal"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
