    "/v1/trends": {
      "get": {
        "summary": "Trends",
        "operationId": "trends_v1_trends_get",
        "parameters": [
          {
            "name": "metric",
            "in": "query",
            "required": false,
            "schema": {
              "const": "volume",
              "type": "string",
              "default": "volume",
              "title": "Metric"
            }
          },
          {
            "name": "signal_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
